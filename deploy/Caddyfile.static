# Static Vue prerender for websmith-shop.com
# Do not fall back unknown URLs to /index.html -- that hides 404s from crawlers.
#
# Example site block:
#
# websmith-shop.com {
#   root * /var/www/mainsite
#   encode gzip
#   import Caddyfile.static
# }

try_files {path} {path}/index.html
file_server

handle_errors {
	@missing expression `{err.status_code} == 404`
	handle @missing {
		rewrite * /404.html
		file_server
	}
}
